rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // One private space per registered choir. Only its owner can read or write it.
    match /choirs/{id} {
      allow read: if request.auth != null && request.auth.uid == id;
      allow create, update: if request.auth != null && request.auth.uid == id
        && request.resource.data.ownerUid == id
        && request.resource.data.state is string
        && request.resource.data.state.size() < 950000;
      allow delete: if false;
    }
    match /{other=**} { allow read, write: if false; }
  }
}
